--- a/libconcord/libconcord.h
+++ b/libconcord/libconcord.h
@@ -299,7 +299,34 @@
  */
 int read_config_from_remote(uint8_t **out, uint32_t *size, lc_callback cb,
                             void *cb_arg);
+
 /*
+ * Read an arbitrary flash range into the caller's buffer. READ ONLY.
+ *
+ * Needed for surveying a model whose firmware location is not in
+ * remote_info.h: arch 12 (Harmony One) has firmware_base = 0, so the regular
+ * dump entry points can only ever read address 0, and there is no other way
+ * to get at the configuration region.
+ *
+ * `out` must already point at `len` writable bytes; nothing is allocated
+ * here, so delete_blob() does not apply.
+ */
+int read_flash_at(uint32_t addr, uint32_t len, uint8_t *out);
+
+/*
+ * READ_MISC with a 16-bit address. READ ONLY.
+ *
+ * `kind` is the subtype: 0 EEPROM, 1 STATE, 4 PROGRAM, 6 RAM, 7 REGISTER.
+ * PROGRAM (4) is the only route that reaches the CPU's own view of memory:
+ * READ_FLASH goes through the JEDEC driver to the external chip, which is
+ * why reading 0x020021 with it returns what is stored in flash (`de ad de
+ * ad`) instead of the keyboard port.
+ *
+ * Returns LC_ERROR_UNSUPP on Z-wave remotes, which do not implement it.
+ * `out` must already point at `len` writable 16-bit words.
+ */
+int read_misc_at(uint16_t addr, uint32_t len, uint8_t kind, uint16_t *out);
+/*
  * Given a config block in the byte array *in that is size big, write
  * it to the remote. This should be *just* the binary blob (see
  * find_binary_start()). CB info above.
--- a/libconcord/libconcord.cpp
+++ b/libconcord/libconcord.cpp
@@ -987,7 +987,33 @@
 
 /*
  * CONFIG-RELATED
+ */
+
+/*
+ * Read an arbitrary flash range. Exposed for surveying models whose firmware
+ * location is unknown: arch 12 (Harmony One) has firmware_base = 0, so the
+ * regular dump entry points can only ever read address 0. Read-only.
  */
+int read_flash_at(uint32_t addr, uint32_t len, uint8_t *out)
+{
+    if (!rmt || !out) {
+        return LC_ERROR;
+    }
+    return rmt->ReadFlash(addr, len, out, ri.protocol, false, NULL, NULL, 0);
+}
+
+int read_misc_at(uint16_t addr, uint32_t len, uint8_t kind, uint16_t *out)
+{
+    if (!rmt || !out) {
+        return LC_ERROR;
+    }
+    /* ReadMiscWord lives on CRemote, not on the base class: Z remotes do not
+       have it. Guard the downcast rather than trust that it never happens. */
+    if (is_z_remote()) {
+        return LC_ERROR_UNSUPP;
+    }
+    return ((CRemote *)rmt)->ReadMiscWord(addr, len, kind, out);
+}
 
 int read_config_from_remote(uint8_t **out, uint32_t *size, lc_callback cb,
                             void *cb_arg)
@@ -1017,7 +1043,13 @@
 
     if ((err = rmt->ReadFlash(ri.arch->config_base, *size, *out, ri.protocol,
                               false, cb, cb_arg, LC_CB_STAGE_READ_CONFIG))) {
-        return LC_ERROR_READ;
+        /*
+         * Pass the specific error through rather than flattening every failure
+         * to LC_ERROR_READ.  This lets a remote that refuses the config file
+         * (e.g. a WiFi hub returning LC_ERROR_UNSUPP) report an accurate
+         * message instead of a misleading "error while reading".
+         */
+        return err ? err : LC_ERROR_READ;
     }
 
     return 0;
--- a/libconcord/remote.h
+++ b/libconcord/remote.h
@@ -211,11 +211,18 @@
 
 class CRemote : public CRemoteBase    // All non-Z-Wave remotes
 {
-private:
+public:
+    /* The two MISC readers become public so the library can expose them.
+       They only READ: subtype PROGRAM (4) is the only route that reaches the
+       CPU's own view of memory, and READ_FLASH cannot do that because it goes
+       through the JEDEC driver to the external chip. The two MISC *writers*
+       stay private. */
     int ReadMiscByte(uint8_t addr, uint32_t len, uint8_t kind,
         uint8_t *rd);
     int ReadMiscWord(uint16_t addr, uint32_t len, uint8_t kind,
         uint16_t *rd);
+
+private:
     int WriteMiscByte(uint8_t addr, uint32_t len, uint8_t kind,
         uint8_t *wr);
     int WriteMiscWord(uint16_t addr, uint32_t len, uint8_t kind,
--- a/libconcord/remote_mh.cpp
+++ b/libconcord/remote_mh.cpp
@@ -218,6 +218,19 @@
     }
     debug("msg_read_file");
     debug_print_packet(rsp);
+
+    /*
+     * A successful read response carries two parameters (an unknown byte plus
+     * the 4-byte data length).  An error response carries a single parameter:
+     * the error code (e.g. 0x0B when the file does not exist / is not served
